import torch 
import torch.nn as nn
import torch.optim as optim
import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.metrics import mean_squared_error
import math

torch.manual_seed(42)
np.random.seed(42)
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

df = pd.read_csv('u.data', sep='\t',
                 names=['user_id','item_id','rating','ts'], usecols=[0,1,2])
df['user_id'] -= 1
df['item_id'] -= 1

m = df['user_id'].max() + 1
n = df['item_id'].max() + 1
print(f"Users: {m}, Items: {n}, Ratings: {len(df)}")

train_df, test_df = train_test_split(df, test_size=0.1, random_state=42)

# -------------------- Constant Baseline --------------------
print("\n" + "="*60)
print("Constant Mean Baseline:")
print("="*60)

train_mean = train_df['rating'].mean()
test_r_numpy = test_df['rating'].values
constant_pred = np.full_like(test_r_numpy, train_mean)
constant_mse = mean_squared_error(test_r_numpy, constant_pred)
constant_rmse = np.sqrt(constant_mse)

print(f"Global mean (train): {train_mean:.4f}")
print(f"Constant baseline Test MSE: {constant_mse:.6f}, RMSE: {constant_rmse:.6f}")

# -------------------- PMF Training --------------------
def train_pmf(k=50, epochs=100, lr=0.01):
    """Train PMF with specific latent dimension k."""
    class PMF(nn.Module):
        def __init__(self, num_users, num_items, k=k):
            super().__init__()
            self.U = nn.Parameter(torch.randn(num_users, k) * 0.1)
            self.V = nn.Parameter(torch.randn(num_items, k) * 0.1)

        def forward(self, u, i):
            return (self.U[u] * self.V[i]).sum(1)

    pmf = PMF(m, n, k).to(device)
    opt = optim.Adam(pmf.parameters(), lr=lr, weight_decay=1e-4)

    train_u = torch.tensor(train_df['user_id'].values, device=device)
    train_i = torch.tensor(train_df['item_id'].values, device=device)
    train_r = torch.tensor(train_df['rating'].values, dtype=torch.float32, device=device)

    test_u = torch.tensor(test_df['user_id'].values, device=device)
    test_i = torch.tensor(test_df['item_id'].values, device=device)
    test_r = torch.tensor(test_df['rating'].values, dtype=torch.float32, device=device)

    best_rmse = float('inf')
    best_state = None

    for epoch in range(epochs):
        pmf.train()
        pred = pmf(train_u, train_i)
        loss = ((pred - train_r)**2).mean()
        opt.zero_grad()
        loss.backward()
        opt.step()

        if (epoch+1) % 50 == 0:
            with torch.no_grad():
                pmf.eval()
                test_pred = pmf(test_u, test_i)
                rmse = torch.sqrt(((test_pred - test_r)**2).mean())
                if rmse < best_rmse:
                    best_rmse = rmse
                    best_state = pmf.state_dict().copy()
            print(f"  PMF (k={k}) Epoch {epoch+1}: Loss={loss.item():.4f}, Test RMSE={rmse.item():.4f}")

    pmf.load_state_dict(best_state)

    return pmf, best_rmse.item()

k_values = [5,10,20,30,40,50,60,80,100,120]
pmf_results = {}

print("\n" + "="*60)
print("Training PMF with different k values:")
print("="*60)

for k in k_values:
    print(f"\nTraining PMF with k={k}:")
    pmf_model, best_rmse = train_pmf(k=k, epochs=100)
    pmf_results[k] = (pmf_model, best_rmse)
    print(f"  Best RMSE for k={k}: {best_rmse:.4f}")

best_k = min(pmf_results.keys(), key=lambda x: pmf_results[x][1])
best_pmf, best_pmf_rmse = pmf_results[best_k]
print(f"\n✓ Best PMF: k={best_k} with RMSE={best_pmf_rmse:.4f}")

best_pmf.eval()
for p in best_pmf.parameters():
    p.requires_grad = False

# -------------------- Pure Perceiver IO Architecture --------------------

class PerceiverIOBlock(nn.Module):
    """Single Perceiver IO processing block"""
    def __init__(self, latent_dim, num_heads, ff_dim=None, dropout=0.1):
        super().__init__()
        if ff_dim is None:
            ff_dim = latent_dim * 4

        self.norm1 = nn.LayerNorm(latent_dim)
        self.cross_attn = nn.MultiheadAttention(latent_dim, num_heads, batch_first=True, dropout=dropout)
        self.dropout1 = nn.Dropout(dropout)

        self.norm2 = nn.LayerNorm(latent_dim)
        self.self_attn = nn.MultiheadAttention(latent_dim, num_heads, batch_first=True, dropout=dropout)
        self.dropout2 = nn.Dropout(dropout)

        self.norm3 = nn.LayerNorm(latent_dim)
        self.ffn = nn.Sequential(
            nn.Linear(latent_dim, ff_dim),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(ff_dim, latent_dim),
            nn.Dropout(dropout)
        )

    def forward(self, latents, inputs):
        latents_norm = self.norm1(latents)
        attn_out, _ = self.cross_attn(latents_norm, inputs, inputs)
        latents = latents + self.dropout1(attn_out)

        latents_norm = self.norm2(latents)
        attn_out, _ = self.self_attn(latents_norm, latents_norm, latents_norm)
        latents = latents + self.dropout2(attn_out)

        latents_norm = self.norm3(latents)
        ffn_out = self.ffn(latents_norm)
        latents = latents + ffn_out

        return latents


class PurePerceiverIO(nn.Module):
    """
    Pure Perceiver IO for Residual Prediction
    NO DIFFUSION - Direct residual prediction
    """
    def __init__(self, num_users, num_items, pmf_model, pmf_k,
                 latent_len=64, latent_dim=256, num_blocks=4, num_heads=8,
                 input_dim=256, dropout=0.1):
        super().__init__()

        self.pmf_model = pmf_model
        self.pmf_k = pmf_k

        self.user_emb = nn.Embedding(num_users, input_dim // 2)
        self.item_emb = nn.Embedding(num_items, input_dim // 2)

        self.pmf_proj = nn.Sequential(
            nn.Linear(pmf_k * 2, input_dim // 2),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(input_dim // 2, input_dim // 2)
        )

        total_input_dim = input_dim + input_dim // 2 + 1
        self.input_proj = nn.Sequential(
            nn.Linear(total_input_dim, latent_dim),
            nn.LayerNorm(latent_dim),
            nn.GELU(),
            nn.Dropout(dropout)
        )

        self.latent = nn.Parameter(torch.randn(1, latent_len, latent_dim) * 0.02)

        self.blocks = nn.ModuleList([
            PerceiverIOBlock(latent_dim, num_heads, dropout=dropout)
            for _ in range(num_blocks)
        ])

        self.output_query_proj = nn.Linear(total_input_dim, latent_dim)
        self.output_cross_attn = nn.MultiheadAttention(latent_dim, num_heads, batch_first=True)
        self.output_norm = nn.LayerNorm(latent_dim)

        self.output_head = nn.Sequential(
            nn.Linear(latent_dim, latent_dim // 2),
            nn.GELU(),
            nn.Dropout(dropout),
            nn.Linear(latent_dim // 2, latent_dim // 4),
            nn.GELU()),
            nn.Dropout(dropout),
            nn.Linear(latent_dim // 4, 1)
        )

    def forward(self, user_ids, item_ids):
        batch_size = user_ids.size(0)

        u_emb = self.user_emb(user_ids)
        i_emb = self.item_emb(item_ids)

        with torch.no_grad():
            pmf_u_emb = self.pmf_model.U[user_ids]
            pmf_i_emb = self.pmf_model.V[item_ids]
            pmf_pred = self.pmf_model(user_ids, item_ids)

        pmf_combined = torch.cat([pmf_u_emb, pmf_i_emb], dim=-1)
        pmf_features = self.pmf_proj(pmf_combined)

        combined = torch.cat([
            u_emb,
            i_emb,
            pmf_features,
            pmf_pred.unsqueeze(-1)
        ], dim=-1)

        inputs = self.input_proj(combined).unsqueeze(1)

        latents = self.latent.expand(batch_size, -1, -1)

        for block in self.blocks:
            latents = block(latents, inputs)

        query = self.output_query_proj(combined).unsqueeze(1)
        decoded, _ = self.output_cross_attn(query, latents, latents)
        decoded = self.output_norm(decoded)

        return self.output_head(decoded).squeeze(-1).squeeze(1)


# -------------------- TRAINING Perceiver IO --------------------

print("\n" + "="*60)
print("Training Pure Perceiver IO (No Diffusion):")
print("="*60)

model = PurePerceiverIO(m, n, best_pmf, best_k).to(device)

optimizer = optim.AdamW(model.parameters(), lr=1e-3, weight_decay=1e-5)
scheduler = optim.lr_scheduler.ReduceLROnPlateau(optimizer, mode='min', factor=0.5,
                                                  patience=10, min_lr=1e-6)

epochs = 150
batch_size = 512

all_u = torch.tensor(df['user_id'].values, device=device)
all_i = torch.tensor(df['item_id'].values, device=device)
all_r = torch.tensor(df['rating'].values, dtype=torch.float32, device=device)

with torch.no_grad():
    base_pred = best_pmf(all_u, all_i)
    residual_target = all_r - base_pred

train_idx = torch.tensor(train_df.index.values, device=device)
test_idx = torch.tensor(test_df.index.values, device=device)

best_val_rmse = float('inf')

for epoch in range(1, epochs + 1):
    model.train()
    epoch_loss = 0.0
    num_batches = 0

    perm = torch.randperm(len(train_idx))

    for i in range(0, len(train_idx), batch_size):
        batch_indices = perm[i:i+batch_size]
        idx = train_idx[batch_indices]

        u_ids = all_u[idx]
        i_ids = all_i[idx]
        target_residuals = residual_target[idx]

        pred_residuals = model(u_ids, i_ids)

        loss = nn.MSELoss()(pred_residuals, target_residuals)

        optimizer.zero_grad()
        loss.backward()
        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
        optimizer.step()

        epoch_loss += loss.item()
        num_batches += 1

    avg_train_loss = epoch_loss / num_batches

    model.eval()
    with torch.no_grad():
        val_preds = []
        val_targets = []

        for i in range(0, len(test_idx), batch_size):
            batch_idx = test_idx[i:i+batch_size]
            u_ids = all_u[batch_idx]
            i_ids = all_i[batch_idx]

            base_pred = best_pmf(u_ids, i_ids)

            pred_residual = model(u_ids, i_ids)

            final_pred = (base_pred + pred_residual).clamp(1.0, 5.0)

            val_preds.append(final_pred)
            val_targets.append(all_r[batch_idx])

        val_preds = torch.cat(val_preds)
        val_targets = torch.cat(val_targets)
        val_rmse = torch.sqrt(((val_preds - val_targets) ** 2).mean()).item()

    scheduler.step(val_rmse)

    print(f"Epoch {epoch:3d} — Train Loss: {avg_train_loss:.6f} | Val RMSE: {val_rmse:.4f}")

    if val_rmse < best_val_rmse:
        best_val_rmse = val_rmse
        torch.save(model.state_dict(), 'best_perceiver_model.pt')

print("\nLoading best model...")
model.load_state_dict(torch.load('best_perceiver_model.pt'))

# -------------------- Final Evaluation --------------------
print("\n" + "="*60)
print("Final Evaluation:")
print("="*60)

model.eval()
final_preds = []

with torch.no_grad():
    test_batch_size = 512
    for i in range(0, len(test_idx), test_batch_size):
        batch_idx = test_idx[i:i+test_batch_size]
        u_ids = all_u[batch_idx]
        i_ids = all_i[batch_idx]

        base_pred = best_pmf(u_ids, i_ids)
        pred_residual = model(u_ids, i_ids)
        final_pred = (base_pred + pred_residual).clamp(1.0, 5.0)
        final_preds.append(final_pred.cpu())

final_preds = torch.cat(final_preds).numpy()
final_rmse = np.sqrt(mean_squared_error(test_df['rating'].values, final_preds))

print("\n" + "="*60)
print("FINAL RESULTS SUMMARY")
print("="*60)
print(f"Constant Mean Baseline RMSE: {constant_rmse:.4f}")
print(f"Best PMF RMSE: {best_pmf_rmse:.4f}")
print(f"Perceiver IO RMSE: {final_rmse:.4f}")
print(f"Improvement over PMF: {(best_pmf_rmse - final_rmse)/best_pmf_rmse*100:.2f}%")
print("="*60)
